#!/command/with-contenv bash
# shellcheck shell=bash
# Moodle's cron, once a minute, inside the container — a new site needs no
# Insula cron job to work.
#
# One run at a time, each started a minute after the previous one started:
# Moodle's "Cron running" check expects a start at least every two minutes.
# --keep-alive=0 because the default keep-alive holds each run open for three
# minutes polling for work, which leaves the last start too old for that check;
# ad hoc tasks (document conversions, …) still get picked up within a minute.
# A run that takes longer (a big course backup) simply delays the next one.
#
# cron.php's output is long and routine (Moodle keeps the per-task logs under
# Site administration > Server > Tasks), so only a failing run reaches the pod
# log.
case "${MOODLE_CRON:-true}" in
  true|TRUE|True|1|yes|on) ;;
  *)
    echo "[insula-moodle] cron is disabled (MOODLE_CRON=${MOODLE_CRON})"
    exec sleep infinity
    ;;
esac

cd /var/www/moodle/code || exit 1
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
while true; do
  start="$(date +%s)"
  if ! php -d max_input_vars=10000 admin/cli/cron.php --keep-alive=0 > "$log" 2>&1; then
    echo "[insula-moodle] cron run failed; last lines:" >&2
    tail -n 20 "$log" >&2
  fi
  elapsed=$(( $(date +%s) - start ))
  if [ "$elapsed" -lt 60 ]; then
    sleep $(( 60 - elapsed ))
  fi
done
