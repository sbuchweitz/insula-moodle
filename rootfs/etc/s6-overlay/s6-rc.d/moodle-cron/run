#!/command/with-contenv bash
# Moodle's cron, every minute, inside the container — a new site needs no
# Insula cron job to work.
#
# cron.php keeps itself alive for a few minutes per run while it works through
# scheduled and ad hoc tasks (Moodle's keepalive), and Moodle's own task locks
# stop two runs from doing the same work. Its output is long and routine
# (Moodle keeps the per-task logs under Site administration > Server > Tasks),
# so only a failing run is written to the pod log.
case "${MOODLE_CRON:-true}" in
  true|TRUE|True|1|yes|on) ;;
  *)
    echo "[insula-moodle] cron is disabled (MOODLE_CRON=${MOODLE_CRON})"
    exec sleep infinity
    ;;
esac

cd /var/www/moodle/code || exit 1
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
while true; do
  if ! php -d max_input_vars=10000 admin/cli/cron.php > "$log" 2>&1; then
    echo "[insula-moodle] cron run failed; last lines:" >&2
    tail -n 20 "$log" >&2
  fi
  sleep 30
done
